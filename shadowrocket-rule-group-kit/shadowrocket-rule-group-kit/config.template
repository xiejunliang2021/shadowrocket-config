# Shadowrocket 自定义配置模板
# [Rule] 区域由 scripts/build.py 每日从官方 lazy_group.conf 同步。
# [Proxy Group] 是你自己的策略组；官方更新不会覆盖这里。

[General]
ipv6 = true
prefer-ipv6 = false
dns-direct-system = false
icmp-auto-reply = true
always-reject-url-rewrite = false
private-ip-answer = true
dns-direct-fallback-proxy = true
udp-policy-not-supported-behaviour = REJECT
block-quic = all-proxy

[Proxy]
# 节点请在 Shadowrocket 首页通过节点订阅单独添加/更新。
# 不要把节点订阅地址写在这里。

[Proxy Group]
# ===== 地区自动测速组 =====
# 蜂窝配置 interval=86400；Wi-Fi 配置 interval=600。
# 仅这些地区组执行 url-test，应用分流组采用 select，不重复测速。
香港节点 = url-test,url=http://www.gstatic.com/generate_204,interval={{INTERVAL}},tolerance=0,timeout=5,select=0,policy-regex-filter=🇭🇰|HK|Hong|hong|香港|深港|沪港|京港|港
台湾节点 = url-test,url=http://www.gstatic.com/generate_204,interval={{INTERVAL}},tolerance=0,timeout=5,select=0,policy-regex-filter=🇹🇼|TW|TWN|Taiwan|Taipei|taiwan|台湾|台灣|台北|台中|新北|彰化
日本节点 = url-test,url=http://www.gstatic.com/generate_204,interval={{INTERVAL}},tolerance=0,timeout=5,select=0,policy-regex-filter=🇯🇵|JP|Japan|japan|Tokyo|tokyo|日本|东京|大阪|京日|苏日|沪日|上日|川日|深日|广日|日
新加坡节点 = url-test,url=http://www.gstatic.com/generate_204,interval={{INTERVAL}},tolerance=0,timeout=5,select=0,policy-regex-filter=🇸🇬|SG|Sing|sing|新加坡|狮城|沪新|京新|深新|杭新|广新
韩国节点 = url-test,url=http://www.gstatic.com/generate_204,interval={{INTERVAL}},tolerance=0,timeout=5,select=0,policy-regex-filter=🇰🇷|KR|Korea|korea|KOR|韩国|首尔|韩|韓|春川
美国节点 = url-test,url=http://www.gstatic.com/generate_204,interval={{INTERVAL}},tolerance=0,timeout=5,select=0,policy-regex-filter=🇺🇸|US|USA|America|america|United States|美国|凤凰城|洛杉矶|西雅图|芝加哥|纽约|沪美|美

# ===== 应用手动选择组 =====
# PROXY 是 Shadowrocket 内置的全局代理策略；可作为通用回退选项。
AI = select,PROXY,香港节点,日本节点,新加坡节点,台湾节点,韩国节点,美国节点,policy-select-name=PROXY
YouTube = select,PROXY,香港节点,日本节点,新加坡节点,台湾节点,美国节点,policy-select-name=PROXY
Netflix = select,PROXY,香港节点,日本节点,新加坡节点,台湾节点,美国节点,policy-select-name=PROXY
Disney+ = select,PROXY,香港节点,日本节点,新加坡节点,台湾节点,美国节点,policy-select-name=PROXY
Max = select,PROXY,香港节点,日本节点,新加坡节点,台湾节点,美国节点,policy-select-name=PROXY
TikTok = select,PROXY,新加坡节点,日本节点,美国节点,香港节点,台湾节点,韩国节点,policy-select-name=PROXY
Spotify = select,DIRECT,PROXY,香港节点,日本节点,新加坡节点,台湾节点,美国节点,policy-select-name=PROXY
Telegram = select,PROXY,香港节点,新加坡节点,日本节点,台湾节点,美国节点,韩国节点,policy-select-name=PROXY
Twitter = select,PROXY,香港节点,日本节点,新加坡节点,台湾节点,美国节点,policy-select-name=PROXY
Facebook = select,PROXY,香港节点,日本节点,新加坡节点,台湾节点,美国节点,policy-select-name=PROXY
PayPal = select,DIRECT,PROXY,香港节点,日本节点,新加坡节点,台湾节点,美国节点,policy-select-name=PROXY
Amazon = select,DIRECT,PROXY,香港节点,日本节点,新加坡节点,台湾节点,美国节点,policy-select-name=PROXY
苹果服务 = select,DIRECT,PROXY,香港节点,台湾节点,日本节点,新加坡节点,美国节点,policy-select-name=DIRECT
谷歌服务 = select,PROXY,香港节点,日本节点,新加坡节点,台湾节点,美国节点,policy-select-name=PROXY
微软服务 = select,DIRECT,PROXY,香港节点,日本节点,新加坡节点,台湾节点,美国节点,policy-select-name=PROXY
哔哩哔哩 = select,DIRECT,PROXY,香港节点,台湾节点,policy-select-name=DIRECT
游戏平台 = select,DIRECT,PROXY,香港节点,日本节点,新加坡节点,台湾节点,美国节点,policy-select-name=PROXY

[Rule]
# BEGIN_OFFICIAL_RULES
{{RULES}}
# END_OFFICIAL_RULES

[Host]
*.apple.com = server:system
*.icloud.com = server:system
localhost = 127.0.0.1

[URL Rewrite]
^https?://(www.)?g.cn https://www.google.com 302
^https?://(www.)?google.cn https://www.google.com 302

[MITM]
# 保留官方配置的 hostname 示例；没有安装并信任证书时，不会执行 HTTPS 解密。
hostname = *.google.cn
